# Root-context deployment allowlist: no local databases, secrets, or artifacts.
**
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!backend/
!backend/requirements.txt
!backend/app/
!backend/app/*.py
!deploy/
!deploy/Dockerfile.render
!deploy/start-render.sh
**/.env*
**/__pycache__/**
**/*.pyc
**/*.db
**/*.sqlite*
**/node_modules/**
**/.git/**
